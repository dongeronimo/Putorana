<?xml version="1.0" encoding="utf-8"?>
<!-- Denser than the button's background: this one has text on it that has to be
     read, not merely noticed. The hairline stroke is what separates the panel
     from a dark scene behind it, where the fill alone would blend in. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#D9000000" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
    <corners android:radius="10dp" />
</shape>
