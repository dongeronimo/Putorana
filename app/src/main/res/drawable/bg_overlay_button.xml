<?xml version="1.0" encoding="utf-8"?>
<!-- The same translucent black the GPU timings sit on. An overlay control has to
     stay findable over a camera image that can be any colour at all, and a
     drop shadow alone does not survive a busy scene. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#99000000" />
    <corners android:radius="8dp" />
</shape>
