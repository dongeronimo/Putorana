<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the world menu. Inflated once per WorldId, never referenced by
     id from the activity. See WorldMenu for why the list is built in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="20dp">

    <!-- INVISIBLE rather than GONE when this is not the current world: the
         labels have to stay on one vertical line, and a tick that took the row
         away with it would make them jump as the selection moved. -->
    <ImageView
        android:id="@+id/check"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_check" />

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        tools:text="HelloWorld" />

</LinearLayout>
