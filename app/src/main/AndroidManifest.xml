<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Vulkan 1.3 is a hard requirement: the renderer has no fallback path.
         The version is the packed Vulkan API version (major << 22 | minor << 12),
         so 1.3 == 0x00403000. Play Store hides the app from devices whose
         VkPhysicalDeviceProperties::apiVersion is lower. -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x00403000"
        android:required="true" />

    <!-- ARCore não abre a câmara sozinho: a permissão é da app, e tem de ser
         pedida em runtime antes de ArSession_resume. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- O tracking do ARCore é visual-inercial: precisa da IMU a 200Hz, e pede-a
         com um report delay de 5ms. Desde a API 31 que amostrar sensores de
         movimento a esse ritmo exige esta permissão, e sem ela o registo do
         sensor falha — o que se manifesta como ArSession_resume a devolver
         AR_ERROR_FATAL com "Failed to register sensor to queue 0" no logcat, e
         não como um erro de permissão. Nada na câmara está errado nesse caso.

         Normal protection level: é concedida na instalação, não se pede em
         runtime. Os samples do SDK não a declaram porque não têm targetSdk 31+. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <!-- "AR Required", e não opcional: não há modo de funcionamento sem
         tracking, tal como não há fallback sem Vulkan 1.3. Consequências, ambas
         desejadas aqui: a Play Store esconde a app de dispositivos sem suporte
         ARCore, e instala o ARCore junto com a app. Uma app AR Optional teria de
         declarar required="false" nos dois sítios e verificar
         ArCoreApk_checkAvailability antes de tocar na sessão. -->
    <uses-feature
        android:name="android.hardware.camera.ar"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ARReconstructor">

        <!-- Par do uses-feature acima: é isto que o Play lê para decidir
             instalar o ARCore com a app. O min_apk_version correspondente vem
             por merge do manifesto do próprio AAR. -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="required" />

        <!-- Fixa em portrait. Uma rotação aqui não é um relayout: destrói a
             Activity, a Surface, o VkDevice, a swapchain e o mundo inteiro, e
             reconstrói tudo — a sessão de AR é a única coisa que sobrevive, por
             viver ao nível da aplicação. Não vale pagar isso numa app cuja
             interface é a câmara.

             Isto NÃO torna o tratamento de rotação do renderer redundante, e por
             isso ele fica: o preTransform da swapchain pode não ser identidade
             mesmo com a orientação fixa, e desde a API 36 o Android ignora esta
             restrição em ecrãs grandes — num tablet a app roda na mesma. O
             ArCamera e o CameraFeed continuam a compor SurfaceRotation, que é o
             que a mantém correta nesse caso. -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>