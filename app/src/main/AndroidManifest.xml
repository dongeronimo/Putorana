<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Vulkan 1.3 is a hard requirement: the renderer has no fallback path.
         The version is the packed Vulkan API version (major << 22 | minor << 12),
         so 1.3 == 0x00403000. Play Store hides the app from devices whose
         VkPhysicalDeviceProperties::apiVersion is lower. -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x00403000"
        android:required="true" />

    <!-- ARCore does not open the camera on its own: the permission belongs to the
         app, and has to be requested at runtime before ArSession_resume. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- ARCore's tracking is visual-inertial: it needs the IMU at 200Hz, and asks
         for it with a 5ms report delay. Since API 31, sampling motion sensors at
         that rate requires this permission, and without it the sensor
         registration fails. That shows up as ArSession_resume returning
         AR_ERROR_FATAL with "Failed to register sensor to queue 0" in logcat, and
         not as a permission error. Nothing is wrong with the camera in that case.

         Normal protection level: granted at install time, never requested at
         runtime. The SDK samples do not declare it because they are not on 31+. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <!-- "AR Required", not optional: there is no mode of operation without
         tracking, the same way there is no fallback without Vulkan 1.3. Two
         consequences, both wanted here: the Play Store hides the app from devices
         with no ARCore support, and it installs ARCore alongside the app. An AR
         Optional app would have to declare required="false" in both places and
         check ArCoreApk_checkAvailability before touching the session. -->
    <uses-feature
        android:name="android.hardware.camera.ar"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ARReconstructor">

        <!-- The partner of the uses-feature above: this is what Play reads to
             decide to install ARCore with the app. The matching min_apk_version
             arrives by manifest merge from the AAR itself. -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="required" />

        <!-- Pinned to portrait. A rotation here is not a relayout: it destroys
             the Activity, the Surface, the VkDevice, the swapchain and the whole
             world, and rebuilds all of it. The AR session is the only thing that
             survives, because it lives at application scope. Not worth paying in
             an app whose interface is the camera.

             This does NOT make the renderer's rotation handling redundant, which
             is why that stays: the swapchain's preTransform can be something
             other than identity even with the orientation pinned, and since API
             36 Android ignores this restriction on large screens, so on a tablet
             the app rotates anyway. ArCamera and CameraFeed still compose
             SurfaceRotation, which is what keeps it correct in that case. -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>